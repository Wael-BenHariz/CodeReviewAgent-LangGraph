{
  "name": "code-review-agent",
  "displayName": "Code Review Agent",
  "description": "Review the active file with the local AI code review backend.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeReviewAgent.reviewCurrentFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeReviewAgent.reviewCurrentFile",
        "title": "Code Review Agent: Review Current File",
        "category": "Code Review Agent",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeReviewAgent.reviewCurrentFile",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code Review Agent",
      "properties": {
        "codeReviewAgent.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the FastAPI code review backend."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.5.4"
  }
}
